grafico = mensual.reset_index()

grafico["Fecha"] = (
    grafico["Periodo"]
    .dt.to_timestamp()
)

plt.figure(figsize=(14, 6))

plt.plot(
    grafico["Fecha"],
    grafico["TRX"],
    marker="o",
    markersize=4,
    linewidth=2
)

plt.title(
    "TRX mensuales - Mercadería en general consolidado"
)

plt.xlabel("Mes")
plt.ylabel("Transacciones totales")

plt.grid(
    axis="y",
    alpha=0.3
)

plt.xticks(rotation=45)
plt.tight_layout()
plt.show()

modelo_trx = modelos["TRX"]

patron_mensual = (
    modelo_trx.seasonal
    .groupby(modelo_trx.seasonal.index.month)
    .mean()
    .reindex(range(1, 13))
)

patron_mensual.index = patron_mensual.index.map(meses)

colores = [
    "#2E8B57" if valor >= 0 else "#C0504D"
    for valor in patron_mensual
]

plt.figure(figsize=(12, 6))

plt.bar(
    patron_mensual.index,
    patron_mensual.values,
    color=colores
)

plt.axhline(
    0,
    color="black",
    linewidth=1
)

plt.title(
    "Patrón estacional mensual - Mercadería en general"
)

plt.xlabel("Mes")
plt.ylabel("Efecto estacional en escala logarítmica")

plt.xticks(rotation=45)
plt.grid(axis="y", alpha=0.3)
plt.tight_layout()
plt.show()
