import numpy as np
import pandas as pd
from statsmodels.tsa.seasonal import STL

# df = tabla completa con todos los MCC (no df_mcc). Ajuste los nombres de columnas.
base = df[(df["Fecha"] >= "2023-01-01") & (df["Fecha"] < "2026-11-01")].copy()
base["Periodo"] = base["Fecha"].dt.to_period("M")
todos = pd.period_range("2023-01", "2026-10", freq="M")

mensual = (base.groupby(["MCC", "Periodo"])
               .agg(TRX=("TRX", "sum"), Negocios=("NegocioId", "nunique"))
               .reset_index())

MIN_MESES = 30        # meses consecutivos con ventas
MIN_NEGOCIOS = 5      # promedio de negocios activos por mes

filas = []
for mcc, g in mensual.groupby("MCC"):
    g = g.set_index("Periodo").reindex(todos)
    activos = g["TRX"].dropna()
    if activos.empty:
        continue
    g = g.loc[activos.index[0]:]                       # desde su primer mes con ventas
    if len(g) < MIN_MESES or g["TRX"].isna().any():    # sin huecos
        continue
    if g["Negocios"].mean() < MIN_NEGOCIOS:
        continue
    g["TRXporNegocio"] = g["TRX"] / g["Negocios"]

    for col in ["TRX", "TRXporNegocio"]:
        y = np.log(g[col])
        y.index = y.index.to_timestamp()
        y = y.asfreq("MS")
        r = STL(y, period=12, robust=True).fit()
        fuerza = max(0, 1 - r.resid.var() / (r.seasonal + r.resid).var())
        por_mes = r.seasonal.groupby(r.seasonal.index.month).mean()
        filas.append({
            "MCC": mcc, "Serie": col, "Meses": len(g),
            "NegociosProm": round(g["Negocios"].mean(), 1),
            "Fuerza": round(fuerza, 2),
            "MesPico": int(por_mes.idxmax()),
            "MesValle": int(por_mes.idxmin()),
        })

res = pd.DataFrame(filas)
res["MesPico"] = res["MesPico"].map(meses)
res["MesValle"] = res["MesValle"].map(meses)
display(res.sort_values(["Serie", "Fuerza"], ascending=[True, False]))
